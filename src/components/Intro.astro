---
import SanityImage from './SanityImage.astro';
const { data } = Astro.props;
const gallery = data.gallery ?? [];
// Photos du marquee : 6 visuels répétés pour avoir assez de cartes pour la boucle
const slides = [1, 2, 3, 4, 5, 6].map((n) => `/images/slide-${n}.webp`);
const cards = [...slides, ...slides];
---
<div class="intro">
  <h2 class="big" data-split>{data.title}</h2>
  <p class="p" data-reveal>{data.text}</p>
  <div class="mq" data-marquee aria-hidden="true">
    {cards.map((src) => (
      <div class="mq-card"><div class="mq-frame"><img src={src} alt="" width="686" height="843" loading="lazy" decoding="async" draggable="false" /></div></div>
    ))}
  </div>
  {gallery.length > 0 && (
    <div class="mos" aria-label="Photos de Maison Muses">
      {gallery.map((g: any) => (
        <div><SanityImage image={g} class="fill" widths={[300, 600, 900]} sizes="(max-width:860px) 40vw, 17vw" /></div>
      ))}
    </div>
  )}
</div>

<style>
  .intro{padding:clamp(100px,16vw,220px) var(--pad) 0}
  .big{max-width:17ch}
  .p{margin:48px 0 0 auto;max-width:42ch;color:var(--ink)}
  /* Marquee empilé : pleine largeur, les cartes sont positionnées par GSAP */
  .mq{position:relative;height:clamp(420px,68vh,640px);margin:clamp(56px,7vw,100px) calc(var(--pad)*-1) 0;overflow:hidden}
  .mq-card{position:absolute;top:50%;left:0;width:min(56vw,380px);aspect-ratio:4/5;margin-top:calc(min(56vw,380px)*-.625);visibility:hidden;will-change:transform,opacity,filter;pointer-events:none}
  .mq-frame{width:100%;height:100%;padding:8px 8px 38px;background:#111;box-shadow:0 20px 50px rgb(0 0 0/.35)}
  .mq-frame img{width:100%;height:100%;object-fit:cover;user-select:none}
  .mos{display:flex;gap:clamp(8px,1.6vw,24px);align-items:flex-end;margin:clamp(72px,9vw,130px) calc(var(--pad)*-1) 0;padding:0 var(--pad);overflow-x:auto;scrollbar-width:none}
  .mos::-webkit-scrollbar{display:none}
  .mos>div{flex:1 0 clamp(140px,17vw,300px);background:var(--surface);border-radius:14px;overflow:hidden}
  .mos>div:nth-child(5n+1){height:380px}.mos>div:nth-child(5n+2){height:500px}.mos>div:nth-child(5n+3){height:340px}.mos>div:nth-child(5n+4){height:540px}.mos>div:nth-child(5n+5){height:420px}
</style>
