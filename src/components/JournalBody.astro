---
// Journal — corps de l'article (richtext Sanity converti en HTML)
// Un seul jeu de styles pour tous les blocs que le client peut créer dans le Studio
interface Props { html: string; }
const { html } = Astro.props;
---

<div class="rt" data-jr-body set:html={html} />

<style>
  .rt {
    --f: clamp(1px, calc(-0.05px + 0.0729167vw), 1.35px);
    font-size: calc(19 * var(--f));
    line-height: 1.65;
  }

  .rt > :global(*) { margin: 0; }
  .rt > :global(* + *) { margin-top: 1.2em; }

  .rt :global(.lead) { font-size: 1.3em; line-height: 1.45; }

  .rt :global(h2) {
    margin-top: 1em;
    font-family: 'Thunder', sans-serif;
    font-weight: 700;
    font-size: calc(54 * var(--f));
    line-height: 0.92;
    text-transform: uppercase;
  }

  .rt :global(h3) {
    margin-top: 1.8em;
    font-family: 'Thunder', sans-serif;
    font-weight: 200;
    font-size: calc(36 * var(--f));
    line-height: 1;
    text-transform: uppercase;
  }

  .rt :global(h2 + *), .rt :global(h3 + *) { margin-top: 0.7em; }
  .rt :global(strong) { font-weight: 700; }
  .rt :global(em) { font-family: 'Cormorant Infant', serif; font-size: 1.15em; }
  .rt :global(a) { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }

  .rt :global(ul), .rt :global(ol) { padding: 0; list-style: none; }
  .rt :global(li) { position: relative; padding-left: 1.6em; }
  .rt :global(li + li) { margin-top: 0.5em; }
  .rt :global(ul > li::before) { content: '✦'; position: absolute; left: 0; top: 0.35em; font-size: 0.7em; }
  .rt :global(ol) { counter-reset: rt; }
  .rt :global(ol > li) { counter-increment: rt; }
  .rt :global(ol > li::before) { content: counter(rt, decimal-leading-zero); position: absolute; left: 0; font-family: 'Cormorant Infant', serif; font-style: italic; }

  .rt :global(blockquote) {
    margin: 2em 0;
    padding-left: 1.2em;
    border-left: 1px solid currentColor;
    font-family: 'Cormorant Infant', serif;
    font-style: italic;
    font-size: calc(36 * var(--f));
    line-height: 1.2;
  }

  .rt :global(blockquote cite) {
    display: block;
    margin-top: 0.6em;
    font-family: var(--font, 'DM Sans', sans-serif);
    font-style: normal;
    font-size: calc(15 * var(--f));
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rt :global(figure) { margin: 2.2em 0; }
  .rt :global(figure .photo) { aspect-ratio: 3 / 2; overflow: hidden; }
  /* Parallaxe (journal.ts) : image 12 % plus haute que son cadre, décalée de 6 % vers le haut */
  .rt :global(figure img) { position: relative; top: -6%; width: 100%; height: 112%; max-width: none; object-fit: cover; display: block; }
  .rt :global(figcaption) { margin-top: 0.6em; font-family: 'Cormorant Infant', serif; font-style: italic; font-size: calc(18 * var(--f)); }

  @media (max-width: 899px) {
    .rt { font-size: 1rem; }
    .rt :global(h2) { font-size: 2.2rem; }
    .rt :global(h3) { font-size: 1.5rem; }
    .rt :global(blockquote) { font-size: 1.5rem; }
  }
</style>
