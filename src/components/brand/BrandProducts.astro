---
// Page marque — les produits : texte, slider (même système que les pages espace), pop-up au clic
import ServiceSlider from '../service/ServiceSlider.astro';
interface Props { brand: any; }
const { brand } = Astro.props;
const modalData = JSON.stringify(brand.products.map((p: any) => p.modal));
// Libellés communs des pages marques : Réglages du site (Sanity + valeurs par défaut, lib/content.ts)
import { loadSettings } from '../../lib/content';
const { brandLabels: labels } = await loadSettings();
---

<section class="br-pr" aria-label="Les produits">
  <div class="br-pr-top">
    <p class="br-lab">{labels.products}</p>
    <div data-br-fade>
      {brand.productsTitle && <p class="br-pr-big">{brand.productsTitle}</p>}
      {brand.productsText && <p class="br-pr-txt">{brand.productsText}</p>}
      {brand.salonList.length > 0 && (
        <>
          <p class="br-key">{brand.salonLabel}</p>
          <ul>{brand.salonList.map((item: string) => <li>{item}</li>)}</ul>
        </>
      )}
    </div>
  </div>
</section>

{brand.products.length > 0 && (
  <div class="br-slider" data-br-products={modalData}>
    <!-- Mobile : pas de curseur au survol, l'invite est écrite au-dessus du slider -->
    <p class="br-hint">{labels.mobileHint}</p>
    <ServiceSlider slides={brand.products} label={`Les produits ${brand.name}, cliquez pour en savoir plus`} />
    <!-- Curseur du slider (souris) : l'étoile des listes du journal, déformée par la vitesse, et une invite -->
    <div class="br-cursor" data-br-cursor aria-hidden="true">
      <span class="br-cursor-star" data-br-cursor-star><svg viewBox="0 0 24 24"><path d="M12 0C12.8 7.6 16.4 11.2 24 12C16.4 12.8 12.8 16.4 12 24C11.2 16.4 7.6 12.8 0 12C7.6 11.2 11.2 7.6 12 0Z" fill="currentColor" /></svg></span>
      <span class="br-cursor-txt">{labels.cursor}</span>
    </div>
  </div>
)}

<!-- Pop-up produit -->
<div class="br-modal" data-br-modal role="dialog" aria-modal="true" aria-labelledby="br-modal-title" hidden>
  <div class="br-veil" data-br-close></div>
  <div class="br-dlg" data-br-dlg>
    <button class="br-close" type="button" data-br-close aria-label="Fermer">✕</button>
    <figure class="br-dlg-photo"><img data-br-m="img" alt="" /></figure>
    <div class="br-dlg-body">
      <h2 id="br-modal-title" data-br-m="name"></h2>
      <p class="br-mut" data-br-m="subtitle"></p>
      <p data-br-m="description"></p>
      <div data-br-m="specs"></div>
      <p class="br-avail">{labels.available}</p>
      <a href={brand.bookingUrl} target="_blank" rel="noopener">{labels.booking}</a>
    </div>
  </div>
</div>

<style>
  .br-pr {
    padding: calc(40 * var(--fpx)) calc(40 * var(--fpx)) calc(110 * var(--fpx));
    color: var(--br-ink, #7d4330);
  }

  .br-pr-top { display: grid; grid-template-columns: 1fr 1fr; gap: calc(20 * var(--fpx)); font-size: 20px; line-height: 1.55; }
  .br-lab { margin: 0; font-size: 20px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--orange, #e57851); }
  .br-pr-big { margin: 0 0 calc(44 * var(--fpx)); font-family: 'Cormorant Infant', serif; font-weight: 300; font-size: clamp(26px, 3vw, 48px); line-height: 1.08; color: var(--orange, #e57851); }
  .br-pr-txt { max-width: 480px; margin: 0 0 calc(90 * var(--fpx)); }
  .br-key { margin: 0; color: var(--orange, #e57851); text-transform: uppercase; letter-spacing: 0.04em; }
  .br-mut { margin: 0; color: var(--br-mut, rgba(125, 67, 48, 0.85)); }
  .br-pr ul { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 14px; }

  .br-slider { --sp-c: var(--orange, #e57851); --mut: rgba(125, 67, 48, 0.85); padding-bottom: calc(140 * var(--fpx)); }
  .br-slider :global(.service-slide) { cursor: pointer; }

  /* ───── Curseur du slider (souris uniquement, activé par scripts/pages/brand.ts) ───── */
  .br-cursor { position: fixed; top: 0; left: 0; z-index: 60; pointer-events: none; }
  /* Fondu sur les enfants : une opacité sur le parent couperait le flou de la pastille */
  .br-cursor > * { visibility: hidden; opacity: 0; }
  /* L'étoile est centrée sur la pointe de la souris, qui reste visible par-dessus */
  .br-cursor-star { position: absolute; left: -9px; top: -9px; width: 18px; height: 18px; color: var(--orange, #e57851); will-change: transform; }
  .br-cursor-star svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .br-cursor-txt { position: absolute; left: 30px; top: 0; transform: translateY(-50%); white-space: nowrap; padding: 9px 15px; border-radius: 999px; background: rgba(247, 242, 236, 0.55); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: var(--orange-ink, #ae4c2c); font-size: 15px; line-height: 1; }

  /* ───── Pop-up : s'ouvre depuis le produit cliqué ───── */
  .br-modal { position: fixed; inset: 0; z-index: 1004; /* au-dessus du header (1001) et du menu (1003) */ display: grid; place-items: center; padding: 4vh 4vw; color: var(--br-ink, #7d4330); }
  .br-modal[hidden] { display: none; }
  .br-veil { position: absolute; inset: 0; background: rgba(15, 47, 51, 0.55); backdrop-filter: blur(10px); }
  .br-dlg { position: relative; width: min(980px, 100%); max-height: 100%; display: grid; grid-template-columns: 0.9fr 1.1fr; background: var(--bg, #F7F2EC); overflow: hidden; }
  .br-dlg-photo { margin: 0; min-height: 300px; overflow: hidden; }
  .br-dlg-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .br-dlg-body { padding: clamp(24px, 3.4vw, 52px); overflow-y: auto; max-height: 88vh; font-size: 20px; line-height: 1.55; }
  .br-dlg-body h2 { margin: 0 0 6px; font-family: 'Cormorant Infant', serif; font-weight: 400; font-size: clamp(40px, 4.6vw, 66px); line-height: 0.95; color: var(--orange, #e57851); }
  .br-dlg-body p { margin: 0 0 20px; }
  .br-dlg-body :global(.br-spec) { display: grid; grid-template-columns: 110px 1fr; gap: 12px; margin: 0 0 12px; }
  .br-dlg-body .br-avail { margin: 28px 0 0; font-style: italic; }
  .br-hint { display: none; }
  .br-dlg-body a { display: inline-block; margin-top: 12px; color: var(--orange, #e57851); text-decoration: underline; text-underline-offset: 0.18em; }
  .br-close { position: absolute; top: 14px; right: 14px; z-index: 2; width: 38px; height: 38px; border: 1px solid rgba(125, 67, 48, 0.35); border-radius: 50%; background: var(--bg, #F7F2EC); color: var(--br-ink, #7d4330); cursor: pointer; }
  .br-close:focus-visible, .br-dlg-body a:focus-visible { outline: 2px solid var(--orange, #e57851); outline-offset: 3px; }

  @media (max-width: 899px) {
    .br-hint { display: block; margin: 0 20px 16px; font-size: 16px; line-height: 1.45; color: var(--orange-ink, #ae4c2c); }
    .br-pr { padding: 24px 20px 56px; }
    .br-pr-top { grid-template-columns: 1fr; }
    .br-lab { display: none; }
    .br-pr-txt { margin-bottom: 40px; }
    .br-slider { padding-bottom: 72px; }
    .br-dlg { grid-template-columns: 1fr; overflow-y: auto; }
    .br-dlg-photo { height: 190px; min-height: 0; }
    .br-dlg-body { max-height: none; }
  }
</style>
