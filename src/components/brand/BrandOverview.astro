---
// Page marque — la marque : grande phrase, origine, qualités, photo
interface Props { brand: any; }
const { brand } = Astro.props;
// Libellés communs des pages marques : Réglages du site (Sanity + valeurs par défaut, lib/content.ts)
import { loadSettings } from '../../lib/content';
const { brandLabels: labels } = await loadSettings();
---

<section class="br-ov" aria-label="La marque">
  {brand.statement && <p class="br-big" data-br-fade>{brand.statement}</p>}
  <div class="br-ov-grid">
    <div class="br-rows" data-br-fade>
      {brand.origin.length > 0 && <><p class="br-key">{labels.origin}</p><p>{brand.origin.map((line: string, i: number) => <>{i > 0 && <br />}{line}</>)}</p></>}
      {brand.qualities.length > 0 && <><p class="br-key">{labels.qualities}</p><ul>{brand.qualities.map((q: string) => <li>{q}</li>)}</ul></>}
    </div>
    <figure class="br-ov-photo" data-br-clip data-sanity={brand.overviewImage.attr}>
      <img src={brand.overviewImage.src} alt={brand.overviewImage.alt} loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

<style>
  .br-ov {
    padding: calc(112 * var(--fpx)) calc(40 * var(--fpx)) calc(120 * var(--fpx));
    color: var(--br-ink, #7d4330);
  }

  .br-big {
    margin: 0 0 calc(130 * var(--fpx));
    font-family: 'Cormorant Infant', serif;
    font-weight: 300;
    font-size: clamp(30px, 4vw, 64px);
    line-height: 1.06;
    color: var(--orange, #e57851);
  }

  .br-ov-grid { display: grid; grid-template-columns: 1fr 1fr; gap: calc(20 * var(--fpx)); }
  .br-rows { display: grid; grid-template-columns: minmax(90px, 0.4fr) 1fr; gap: calc(44 * var(--fpx)) calc(28 * var(--fpx)); align-content: start; font-size: 20px; line-height: 1.55; }
  .br-rows p { margin: 0; }
  .br-mut { color: var(--br-mut, rgba(125, 67, 48, 0.85)); }
  /* Intitulés « Origine » / « Qualités » : majuscules en orange, même taille que le texte à côté */
  .br-key { color: var(--orange, #e57851); text-transform: uppercase; letter-spacing: 0.04em; }
  .br-rows ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }

  .br-ov-photo { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
  .br-ov-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 899px) {
    .br-ov { padding: 64px 20px 72px; }
    .br-big { margin-bottom: 48px; }
    .br-ov-grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
