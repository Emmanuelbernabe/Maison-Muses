---
import Lien from './Lien.astro';
const { data } = Astro.props;
const advice = (data.advice?.items ?? []).filter(Boolean);
const episodes = (data.podcast?.items ?? []).filter(Boolean);
const fmt = (d: string) => new Date(d).toLocaleDateString('fr-FR', { timeZone: 'UTC' });
---
<section>
  <div class="head">
    <h2 class="big" data-split>{data.title}</h2>
    <p class="p" data-reveal>{data.text}</p>
  </div>
  <div class="diag">
    {(data.diagnostics ?? []).map((d: any) => (
      <a href={d.url} data-reveal><h3>{d.title}</h3><Lien as="span">{d.ctaLabel || 'Commencer'}</Lien></a>
    ))}
  </div>
  <div class="cols">
    {advice.length > 0 && (
      <div data-reveal>
        <h3>{data.advice.title}</h3>
        <ul>{advice.map((a: any) => <li><a href={a.url}>{a.title}<span>{a.linkLabel || 'Lire l’article'}</span></a></li>)}</ul>
      </div>
    )}
    {episodes.length > 0 && (
      <div data-reveal>
        <h3>{data.podcast.title}</h3>
        <ul>{episodes.map((e: any) => <li><a href={e.url}>{e.title}<span>{e.date ? fmt(e.date) : ''}</span></a></li>)}</ul>
      </div>
    )}
  </div>
</section>

<style>
  .diag{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .diag a{background:var(--surface);border-radius:14px;min-height:380px;padding:32px;display:flex;flex-direction:column;justify-content:flex-end;gap:28px;align-items:flex-start}
  .diag h3{font-weight:400;font-size:clamp(30px,3.6vw,52px);letter-spacing:-.03em;line-height:1}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,90px);margin-top:80px}
  .cols h3{font-weight:400;font-size:clamp(28px,3.4vw,48px);letter-spacing:-.03em;line-height:1.05;margin-bottom:48px}
  ul{list-style:none;margin:0;padding:0;border-bottom:1px solid var(--line)}
  li{border-top:1px solid var(--line)}
  /* padding-left animé par GSAP au survol */
  .cols a{display:flex;justify-content:space-between;gap:24px;padding:22px 0;font-size:clamp(18px,1.8vw,24px);letter-spacing:-.01em;line-height:1.2}
  .cols span{color:var(--muted);font-size:14px;white-space:nowrap;align-self:center}
  @media (max-width:860px){.cols,.diag{grid-template-columns:1fr}}
</style>
