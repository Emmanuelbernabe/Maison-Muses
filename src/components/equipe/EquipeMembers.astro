---
// Page L'équipe — les membres : la liste des prénoms à gauche (groupés par étiquette : Muses Coiffure,
// Muses Bien-être…), la fiche du membre choisi au centre (photo) et à droite (nom, métier, présentation, réservation).
// Au clic sur un prénom, la fiche sort et la suivante entre (scripts/pages/equipe.ts).
// Contenu : document « Page L'équipe » → Membres (Sanity + valeurs par défaut, lib/content.ts)
import { picture, href } from '../../lib/content';
import { clean } from '../../lib/sanity';
import { rich } from '../../lib/rich';
const { equipe } = Astro.props;

const members = equipe.members.map((mb: any, i: number) => ({
  ...mb,
  key: `m${i}`,
  photo: picture(mb.imageMain, '(max-width: 899px) 90vw, 400px'),
  // Membres du bien-être : fiche sur fond vert, textes en crème
  green: /bien/i.test(clean(mb.tag)),
}));

// Groupes, dans l'ordre d'apparition : les membres qui partagent la même étiquette sont réunis
const groups: { tag: string; members: any[] }[] = [];
for (const mb of members) {
  const tagText = clean(mb.tag).replace(/[*_]/g, '').trim();
  let g = groups.find((x) => x.tag === tagText);
  if (!g) groups.push((g = { tag: tagText, members: [] }));
  g.members.push(mb);
}
const label = members.map((mb: any) => clean(mb.name)).join(', ');
---

<section class:list={["em", { "is-green": members[0]?.green }]} id="em" data-anim="em-team" aria-label={`L’équipe : ${label}`}>
  <!-- Liste des membres -->
  <nav class="em-list" aria-label="Choisir un membre de l’équipe">
    {groups.map((g) => (
      <div class="em-group">
        <p class="em-group-tag">{g.tag}</p>
        <ul>
          {g.members.map((mb) => (
            <li>
              <button class:list={['em-pick', { 'is-active': mb.key === 'm0' }]} type="button" data-em-pick={mb.key} aria-controls={`em-${mb.key}`} aria-pressed={mb.key === 'm0' ? 'true' : 'false'}>{mb.name}</button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <!-- Fiches : une seule visible à la fois -->
  <div class="em-stage">
    {members.map((mb: any, i: number) => (
      <article class="em-panel" id={`em-${mb.key}`} data-em-panel={mb.key} data-em-green={mb.green ? "" : undefined} hidden={i > 0}>
        <figure class="em-photo" data-em-clip><img src={mb.photo.src} srcset={mb.photo.srcset} sizes={mb.photo.sizes} alt={mb.photo.alt} loading="lazy" decoding="async" /></figure>
        <div class="em-col">
          <h2 class="em-name em-mask" data-em-line><span>{mb.name}</span></h2>
          <p class="em-role em-mask" data-em-line><span>{mb.role}</span></p>
          {/* Présentation : une ligne vide dans Sanity = un nouveau paragraphe (écart réduit plutôt qu’une ligne blanche) */}
          <div class="em-bio" data-em-fade>
            {String(mb.bio ?? '').split(/\n\s*\n/).filter((par: string) => par.trim()).map((par: string) => (
              <p>{rich(par).map((p) => (p.br ? <br /> : p.bold ? <b>{p.text}</b> : p.italic ? <i>{p.text}</i> : p.text))}</p>
            ))}
          </div>
          {/* Pas de bouton sans texte ou sans adresse (membre sans réservation en ligne) */}
          {clean(mb.cta?.label) && clean(mb.cta?.url) && <a class="em-cta" href={href(mb.cta.url)} target="_blank" rel="noopener" data-em-fade>{mb.cta.label}</a>}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Desktop : la photo et le texte tiennent dans un écran sous la nav (--em-h) ; marges haut et bas identiques.
     --eu : unité de la section = la plus petite des deux échelles, largeur (--fpx) ou hauteur (1px pour 900px de haut) ;
     textes, écarts et largeur de la photo en dépendent, la hauteur de la photo prend tout l'espace sous la nav. */
  .em {
    --eu: min(var(--fpx), calc(100svh / 900));
    --em-top: calc(100px + 24 * var(--eu));    /* hauteur de la nav + respiration */
    --em-bottom: calc(44 * var(--eu));
    --em-h: calc(100svh - var(--em-top) - var(--em-bottom));
    display: grid;
    grid-template-columns: calc(436 * var(--fpx)) minmax(0, 1fr);
    align-items: start;
    box-sizing: border-box;
    /* même marge en bas qu'en haut (la section dépasse alors un peu de l'écran) ; écart avec le footer comme sur l'accueil */
    padding: var(--em-top) calc(48 * var(--fpx));
    margin-bottom: calc(140 * var(--fpx));
    background: var(--bg, #F7F2EC);
    color: var(--orange, #e57851);
    transition: background-color 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Membre du bien-être affiché : fond vert, tous les textes de la section en crème */
  .em.is-green { background: var(--em-green, #11311A); }
  .em.is-green :is(.em-group-tag, .em-pick, .em-name, .em-role, .em-bio, .em-cta) { color: var(--bg, #F7F2EC); }
  .em-group-tag, .em-pick, .em-name, .em-role, .em-bio, .em-cta { transition: color 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease; }

  /* ── Liste : étiquette du groupe, puis les prénoms ; celui affiché en orange plein ── */
  .em-list { display: flex; flex-direction: column; gap: calc(30 * var(--eu)); }
  .em-group-tag {
    margin: 0 0 calc(10 * var(--eu));
    font-family: 'Thunder', sans-serif;
    font-weight: 400;
    font-size: calc(17 * var(--eu));
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }
  .em-group ul { list-style: none; margin: 0; padding: 0; }
  .em-pick {
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: 'Cormorant Infant', serif;
    font-weight: 400;
    font-size: calc(46 * var(--eu));
    line-height: 1.26;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-align: left;
    color: var(--orange, #e57851);
    opacity: 0.38;
    transition: opacity 0.4s ease, color 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .em-pick:hover, .em-pick:focus-visible, .em-pick.is-active { opacity: 1; }
  .em-pick:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }

  /* ── Fiche : photo, puis la colonne de texte, toutes deux de la hauteur disponible ── */
  .em-stage { display: grid; }
  .em-panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: calc(400 * var(--eu)) minmax(0, 1fr);
    column-gap: calc(56 * var(--fpx));
    height: var(--em-h);
  }
  .em .em-panel[hidden] { display: none !important; }

  .em-photo { margin: 0; height: 100%; overflow: hidden; border-radius: 2px; }
  .em-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .em-col { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; min-height: 0; }
  .em-mask { display: block; overflow: hidden; padding-block: 0.1em; margin-block: -0.1em; }
  .em-mask > span { display: inline-block; }

  /* Nom : le haut des capitales aligné sur le haut de la photo (Cormorant : ~0,22em d’espace au-dessus des capitales, accents non comptés) */
  .em-name {
    margin: -0.22em 0 0;
    font-family: 'Cormorant Infant', serif;
    font-weight: 400;
    font-size: calc(76 * var(--eu));
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--orange, #e57851);
  }
  .em-role {
    margin: calc(12 * var(--eu)) 0 0;
    font-size: calc(20 * var(--eu));
    line-height: 1.3;
    color: var(--orange-ink, #ae4c2c);
  }
  .em-bio {
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--eu));
    margin: calc(26 * var(--eu)) 0 0;
    max-width: calc(452 * var(--fpx));
    font-size: calc(18 * var(--eu));
    line-height: 1.5;
    color: var(--orange-ink, #ae4c2c);
  }
  .em-bio p { margin: 0; }
  .em-bio b { font-weight: 700; }
  .em-cta {
    margin-top: auto;
    padding-top: calc(24 * var(--eu));
    font-size: calc(24 * var(--eu));
    line-height: 1;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    color: var(--orange-ink, #ae4c2c);
    white-space: nowrap;
  }

  /* Mobile / tablette : prénoms en ligne, puis la photo et le texte empilés (hauteur libre) */
  @media (max-width: 899px) {
    .em { grid-template-columns: 1fr; row-gap: 2rem; padding: 4rem 1.25rem; margin-bottom: 5rem; }
    .em-list { flex-direction: row; flex-wrap: wrap; gap: 1.25rem 2rem; }
    .em-group-tag { font-size: 0.95rem; margin-bottom: 0.35rem; }
    .em-pick { font-size: 1.9rem; line-height: 1.2; }
    .em-panel { grid-template-columns: 1fr; row-gap: 1.5rem; height: auto; }
    .em-photo { height: auto; aspect-ratio: 4 / 5; }
    .em-name { font-size: 2.8rem; }
    .em-role { margin-top: 0.5rem; font-size: 1.05rem; }
    .em-bio { margin-top: 1.1rem; max-width: none; font-size: 0.98rem; gap: 0.6rem; }
    .em-cta { margin-top: 1.5rem; padding-top: 0; font-size: 1.15rem; white-space: normal; }
  }
</style>
