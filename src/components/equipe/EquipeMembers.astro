---
// Page L'équipe — Moussine puis Violaine : la section se fige et le scroll fait le relais entre les deux
// Contenu : document « Page L'équipe » → Membres (Sanity + valeurs par défaut, lib/content.ts)
// Dans l'accroche, {coeur} est remplacé par le petit cœur dessiné
import { picture, href } from '../../lib/content';
import { clean } from '../../lib/sanity';
import { rich, lines } from '../../lib/rich';
const { equipe } = Astro.props;
// Deux panneaux : m (Moussine, mise en page orange) puis v (Violaine)
const keys = ['m', 'v'];
const members = equipe.members.slice(0, 2).map((mb: any, i: number) => ({
  ...mb,
  key: keys[i],
  big: picture(mb.imageMain),
  small: picture(mb.imageSecond),
}));
const label = members.map((mb: any) => clean(mb.name)).join(' et ');
---

<section class="em" id="em" data-anim="em-relay" aria-label={label}>
  {members.map((mb: any, i: number) => (
    <div class={`em-panel em-${mb.key}`} data-em-panel={mb.key} hidden={i > 0}>
      <div class="em-head">
        <p class="em-tag em-mask" data-em-line><span>{rich(mb.tag).map((p) => (p.br ? <br /> : p.bold ? <b>{p.text}</b> : p.italic ? <i>{p.text}</i> : p.text))}</span></p>
        <p class="em-lead">
          {lines(mb.lead).map((line, k) => (
            <span class:list={['em-mask', { 'em-l1': i === 0 && k === 0 }]} data-em-line><span>{line.split('{coeur}').map((part, j) => <>{j > 0 && <img class="em-heart" src="/images/coeur_orange.svg" alt="cœur" width="80" height="80" />}{part}</>)}</span></span>
          ))}
        </p>
      </div>

      <figure class="em-photo em-big" data-em-clip><img src={mb.big.src} alt={mb.big.alt} loading="lazy" decoding="async" /></figure>
      <figure class="em-photo em-small" data-em-clip><img src={mb.small.src} alt={mb.small.alt} loading="lazy" decoding="async" /></figure>

      <div class="em-col">
        <div class="em-id">
          <h2 class="em-name em-mask" data-em-line><span>{mb.name}</span></h2>
          <p class="em-role em-mask" data-em-line><span>{mb.role}</span></p>
        </div>
        <p class="em-bio" data-em-fade>{rich(mb.bio).map((p) => (p.br ? <br /> : p.bold ? <b>{p.text}</b> : p.italic ? <i>{p.text}</i> : p.text))}</p>
        <a class="em-cta" href={href(mb.cta.url)} target="_blank" rel="noopener" data-em-fade>{mb.cta.label}</a>
      </div>
    </div>
  ))}
</section>

<style>
  /* Unité fluide --fpx (global.css), sur toute la largeur de l'écran */
  .em {
    --em-pad: calc(40 * var(--fpx));          /* padding gauche / droite des sections */
    --em-top: calc(100 * var(--fpx));         /* haut du titre = haut de la grande image */
    --em-small-top: calc(300 * var(--fpx));   /* haut de la petite image = haut de la colonne de texte */
    --em-big-w: calc(399 * var(--fpx));
    --em-small-w: calc(388 * var(--fpx));
    --em-gap: calc(36 * var(--fpx));          /* espace entre les textes et les images */
    --em-green: #11311A;
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: var(--bg, #F7F2EC);
    transition: background-color 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .em.show-v { background: var(--em-green); }

  .em-panel {
    position: absolute;
    inset: 0;
    font-family: var(--font, 'DM Sans', sans-serif);
  }

  .em .em-panel[hidden] { display: none !important; }
  .em-m { --c: var(--orange, #e57851); }
  .em-v { --c: #F7F2EC; }
  .em-panel > * { position: absolute; margin: 0; }

  .em-mask { display: block; overflow: hidden; padding-block: 0.1em; margin-block: -0.1em; }
  .em-mask > span { display: inline-block; }

  /* ── Titre : aligné sur le haut de la grande image ── */
  .em-head { top: var(--em-top); width: max-content; color: var(--c); }
  .em-m .em-head { left: var(--em-pad); }
  .em-v .em-head { right: var(--em-pad); text-align: right; }

  .em-tag {
    position: absolute;
    left: 0;
    top: calc(8 * var(--fpx));
    font-family: 'Thunder', sans-serif;
    font-weight: 200;
    font-size: calc(24 * var(--fpx));
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: left;
  }

  .em-tag i { font-family: 'Thunder LC', 'Thunder', sans-serif; font-style: normal; }

  .em-lead {
    font-family: 'Thunder', sans-serif;
    font-weight: 800;
    font-size: calc(80 * var(--fpx));
    line-height: 0.74;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Moussine : la 1re ligne commence après le tag */
  .em-m .em-l1 { padding-left: calc(220 * var(--fpx)); }
  /* Cœur : à la taille des capitales, posé sur la ligne de base comme une lettre */
  .em-heart {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    vertical-align: -0.1em;
  }

  /* ── Images : collées aux bords de l'écran, jusqu'en bas ── */
  .em-photo { overflow: hidden; bottom: 0; }
  .em-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .em-big { top: var(--em-top); width: var(--em-big-w); }
  .em-small { top: var(--em-small-top); width: var(--em-small-w); }
  .em-m .em-big { right: 0; }
  .em-m .em-small { left: 0; }
  .em-v .em-big { left: 0; }
  .em-v .em-small { right: 0; }

  /* ── Colonne de texte : nom + métier, paragraphe centré, bouton à 24 du bas ── */
  .em-col {
    top: var(--em-small-top);
    bottom: calc(24 * var(--fpx));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: calc(24 * var(--fpx));
    color: var(--c);
  }

  .em-m .em-col { left: calc(var(--em-small-w) + var(--em-gap)); right: calc(var(--em-big-w) + var(--em-gap)); align-items: flex-start; }
  .em-v .em-col { left: calc(var(--em-big-w) + var(--em-gap)); right: calc(var(--em-small-w) + var(--em-gap)); align-items: flex-end; text-align: right; }

  .em-id { display: flex; flex-direction: column; gap: calc(6 * var(--fpx)); }
  .em-v .em-id { align-items: flex-end; }

  .em-name {
    font-family: 'Cormorant Infant', serif;
    font-weight: 400;
    font-size: calc(80 * var(--fpx));
    line-height: 0.7;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .em-role { font-size: calc(26 * var(--fpx)); line-height: 1; text-transform: uppercase; }
  .em-bio { max-width: calc(480 * var(--fpx)); font-size: calc(17.5 * var(--fpx)); line-height: 1.5; }
  .em-bio b { font-weight: 700; }
  .em-cta { font-size: calc(29 * var(--fpx)); line-height: 1; text-transform: uppercase; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; white-space: nowrap; }

  /* Mobile : même relais, contenu empilé (deux photos côte à côte) */
  @media (max-width: 899px) {
    .em { height: 100svh; }
    .em-panel { display: grid; grid-template-columns: 1.25fr 1fr; column-gap: 0.8rem; row-gap: 0.8rem; align-content: start; padding: 4.5rem 1.25rem 1.25rem; }
    .em-panel > * { position: relative; inset: auto; left: auto !important; right: auto !important; top: auto !important; bottom: auto !important; width: auto !important; grid-column: 1 / -1; }
    .em-head, .em-v .em-head { text-align: left; }
    .em-tag { position: relative; top: 0; font-size: 1.1rem; margin-bottom: 0.4rem; }
    .em-lead { font-size: 1.85rem; white-space: normal; }
    .em-m .em-l1 { padding-left: 0; }
    /* « .em-panel > » : plus spécifique que « .em-panel > * » une fois scopé par Astro */
    .em-panel > .em-big { grid-column: 1; height: 30vh; }
    .em-panel > .em-small { grid-column: 2; height: 21vh; align-self: end; }
    .em-col, .em-v .em-col { align-items: flex-start; text-align: left; justify-content: flex-start; gap: 0.8rem; }
    .em-v .em-id { align-items: flex-start; }
    .em-name { font-size: 2.8rem; }
    .em-role { font-size: 0.95rem; }
    .em-bio { max-width: none; font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    .em-cta { font-size: 1.05rem; }
  }
</style>