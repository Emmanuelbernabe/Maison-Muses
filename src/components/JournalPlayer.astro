---
// Journal — player audio des épisodes de podcast (fichier ajouté dans Sanity)
interface Props { src: string; type?: string; episode?: number; title: string; }
const { src, type, episode, title } = Astro.props;
---

<div class="jr-player" data-jr-player role="group" aria-label={`Lecteur audio : ${title}`}>
  <audio preload="metadata" data-jr-audio>
    <source src={src} type={type || 'audio/mpeg'} />
  </audio>

  <button class="jr-play" type="button" data-jr-play aria-label="Lire l’épisode">
    <svg class="jr-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor" /></svg>
    <svg class="jr-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 4.5h4v15h-4zM13.5 4.5h4v15h-4z" fill="currentColor" /></svg>
  </button>

  <div class="jr-player-main">
    <div class="jr-player-top">
      <span class="jr-player-label">{episode ? <>Épisode <b>{episode}</b></> : <b>Écouter l’épisode</b>}</span>
      <span class="jr-player-time"><span data-jr-current>0:00</span> / <span data-jr-duration>--:--</span></span>
    </div>
    <input class="jr-seek" type="range" min="0" max="1000" step="1" value="0" data-jr-seek aria-label="Position dans l’épisode" />
    <div class="jr-player-tools">
      <button type="button" data-jr-skip="-15" aria-label="Reculer de 15 secondes">−15 s</button>
      <button type="button" data-jr-skip="30" aria-label="Avancer de 30 secondes">+30 s</button>
      <button type="button" data-jr-rate aria-label="Vitesse de lecture : 1 fois">1×</button>
    </div>
  </div>
</div>

<style>
  .jr-player {
    --f: clamp(1px, calc(-0.05px + 0.0729167vw), 1.35px);
    --jr-p: 0%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: calc(28 * var(--f));
    width: min(calc(820 * var(--f)), 100%);
    padding: calc(22 * var(--f)) calc(26 * var(--f));
    border: 1px solid currentColor;
    color: var(--orange, #e57851);
    text-align: left;
  }

  .jr-play {
    position: relative;
    width: calc(76 * var(--f));
    height: calc(76 * var(--f));
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--orange, #e57851);
    color: var(--bg, #F7F2EC);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .jr-play:hover { transform: scale(1.06); }
  .jr-play svg { width: 40%; height: 40%; grid-area: 1 / 1; }
  .jr-icon-pause, .jr-player.is-playing .jr-icon-play { display: none; }
  .jr-player.is-playing .jr-icon-pause { display: block; }

  .jr-player-main { display: flex; flex-direction: column; gap: calc(12 * var(--f)); min-width: 0; }
  .jr-player-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }

  .jr-player-label {
    font-family: 'Thunder', sans-serif;
    font-weight: 200;
    font-size: calc(26 * var(--f));
    line-height: 1;
    text-transform: uppercase;
  }

  .jr-player-label b { font-weight: 700; }
  .jr-player-time { font-family: 'Cormorant Infant', serif; font-style: italic; font-size: calc(20 * var(--f)); font-variant-numeric: tabular-nums; }

  /* Barre de progression : la partie lue est pleine (--jr-p mis à jour par journal.ts) */
  .jr-seek {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 18px;
    margin: 0;
    background: transparent;
    color: inherit;   /* sinon le curseur prend la couleur grise par défaut des champs */
    cursor: pointer;
  }

  .jr-seek::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(90deg, currentColor var(--jr-p), rgba(229, 120, 81, 0.25) var(--jr-p));
  }

  .jr-seek::-moz-range-track { height: 2px; background: rgba(229, 120, 81, 0.25); }
  .jr-seek::-moz-range-progress { height: 2px; background: currentColor; }

  .jr-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border: 0;
    border-radius: 50%;
    background: currentColor;
  }

  .jr-seek::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: currentColor; }
  .jr-seek:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  .jr-player-tools { display: flex; gap: calc(10 * var(--f)); }

  .jr-player-tools button {
    padding: calc(7 * var(--f)) calc(14 * var(--f)) calc(5 * var(--f));
    border: 1px solid currentColor;
    border-radius: 999px;
    background: none;
    color: inherit;
    cursor: pointer;
    font-family: 'Thunder', sans-serif;
    font-size: calc(18 * var(--f));
    line-height: 1;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s;
  }

  .jr-player-tools button:hover { background: var(--orange, #e57851); color: var(--bg, #F7F2EC); }
  .jr-play:focus-visible, .jr-player-tools button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  @media (max-width: 899px) {
    .jr-player { gap: 1rem; padding: 1rem; }
    .jr-play { width: 3.6rem; height: 3.6rem; }
    .jr-player-label { font-size: 1.1rem; }
    .jr-player-time { font-size: 0.95rem; }
    .jr-player-tools button { font-size: 0.85rem; }
  }

  @media (prefers-reduced-motion: reduce) { .jr-play { transition: none; } }
</style>
