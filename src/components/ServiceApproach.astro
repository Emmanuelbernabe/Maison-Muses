---
// Pages espace — présentation : titre qui se remplit au scroll, deux photos
import { clean } from '../lib/sanity';
interface Props { approach: any; }
const { approach } = Astro.props;
const words = String(approach.title).split(' ');
---

<section class="cf-approach" aria-label={clean(approach.tag)}>
  <div class="cf-approach-text">
    <div class="cf-approach-top">
      <p class="cf-tag" data-cf-fade>{approach.tag}</p>
      <!-- Mots découpés : ils se remplissent un par un au scroll, comme le titre de la section 4 de la home -->
      <h2 class="cf-approach-title" data-anim="cf-fill">
        {words.map((word) => <span class="cf-word">{word}</span>)}
      </h2>
      <p class="cf-body" data-cf-fade>{approach.text}</p>
      {approach.ctaLabel && <a class="cf-cta" href={approach.ctaUrl} target={approach.ctaUrl?.startsWith('http') ? '_blank' : undefined} rel="noopener" data-cf-fade>{approach.ctaLabel}</a>}
    </div>
    <!-- Petite photo : sans clip-path -->
    <figure class="cf-approach-small" data-sanity={approach.small.attr}><img src={approach.small.src} alt={approach.small.alt} loading="lazy" decoding="async" /></figure>
  </div>
  <figure class="cf-approach-big" data-cf-clip data-sanity={approach.big.attr}><img src={approach.big.src} alt={approach.big.alt} loading="lazy" decoding="async" /></figure>
</section>

<style>
  .cf-approach {
    --f: clamp(1px, calc(-0.05px + 0.0729167vw), 1.35px);
    display: flex;
    justify-content: space-between;
    gap: calc(60 * var(--f));
    padding: calc(200 * var(--f)) calc(40 * var(--f)) calc(74 * var(--f));
    color: var(--sp-c, #e57851);
  }

  .cf-approach figure { margin: 0; overflow: hidden; }
  .cf-approach img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .cf-approach-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: calc(40 * var(--f));
  }

  .cf-approach-top { display: flex; flex-direction: column; align-items: flex-start; }

  .cf-tag {
    margin: 0 0 calc(12 * var(--f));
    font-family: 'Thunder', sans-serif;
    font-weight: 200;
    font-size: calc(22 * var(--f));
    line-height: 1;
    text-transform: uppercase;
  }

  .cf-approach-title {
    margin: 0;
    max-width: calc(700 * var(--f));
    font-family: 'Thunder', sans-serif;
    font-weight: 400;
    font-size: calc(50 * var(--f));
    line-height: 0.88;
    text-transform: uppercase;
  }

  /* Couleur pleine : c'est l'opacité qui est animée au scroll (coiffure.ts) */
  .cf-word { display: inline-block; margin-right: 0.22em; color: var(--sp-c, #e57851); }

  .cf-body {
    margin: calc(42 * var(--f)) 0 0;
    max-width: calc(510 * var(--f));
    font-size: calc(17 * var(--f));
    line-height: 1.5;
  }

  .cf-cta {
    margin-top: calc(46 * var(--f));
    font-size: calc(22 * var(--f));
    line-height: 1;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    color: inherit;
  }

  .cf-approach-small { width: calc(206 * var(--f)); height: calc(136 * var(--f)); }
  .cf-approach-big { flex-shrink: 0; width: calc(437 * var(--f)); height: calc(580 * var(--f)); }

  @media (max-width: 899px) {
    .cf-approach { flex-direction: column; padding: 5rem 1.25rem 3rem; gap: 2.5rem; }
    .cf-approach-title { font-size: 2.2rem; }
    .cf-tag { font-size: 1rem; }
    .cf-body { font-size: 0.95rem; }
    .cf-cta { font-size: 1rem; }
    .cf-approach-small { display: none; }
    .cf-approach-big { width: 100%; height: 115vw; }
  }
</style>
