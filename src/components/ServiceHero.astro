---
// Pages espace (coiffure, bien-être) — hero : vidéo plein écran, titre centré. Contenu : Sanity (voir lib/servicePage.ts)
interface Props { hero: any; label: string; }
const { hero, label } = Astro.props;
---

<section class="cf-hero" data-anim="cf-hero" aria-label={label}>
  <video src={hero.video} poster={hero.poster} data-sanity={hero.videoAttr} autoplay muted loop playsinline preload="metadata"></video>
  <div class="cf-hero-text">
    <p class="cf-hero-small" data-cf-in>{hero.eyebrow}</p>
    <h1 class="cf-hero-title" data-cf-in>{hero.title}</h1>
    <p class="cf-hero-small" data-cf-in>{hero.signature}</p>
  </div>
</section>

<style>
  .cf-hero {
    --f: clamp(1px, calc(-0.05px + 0.0729167vw), 1.35px);
    position: relative;
    height: 100vh;
    padding: 0;   /* annule le padding global des sections */
    overflow: hidden;
    background: #1a120d;
  }

  .cf-hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8);
  }

  .cf-hero-text {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(12 * var(--f));
    color: var(--bg, #F7F2EC);
    text-align: center;
  }

  .cf-hero-small {
    margin: 0;
    font-family: var(--font, 'DM Sans', sans-serif);
    font-size: calc(28 * var(--f));
    line-height: 1;
    text-transform: uppercase;
  }

  .cf-hero-title {
    margin: 0;
    font-family: 'Cormorant Infant', serif;
    font-weight: 400;
    font-size: calc(80 * var(--f));
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  @media (max-width: 899px) {
    .cf-hero { height: 100svh; }
    .cf-hero-small { font-size: 1.1rem; }
    .cf-hero-title { font-size: 3.2rem; }
  }
</style>
