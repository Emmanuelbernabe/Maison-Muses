---
// Accueil — Journal des Muses : les 5 derniers articles du journal (Sanity), couverture en aperçu au survol
import { getJournalPosts, clean } from '../../lib/sanity';
import { journalCover, journalReadingTime } from '../../lib/journal';
import { href } from '../../lib/content';
import { rich } from '../../lib/rich';
// Titre, bouton et filtres : section journal de la page d'accueil (Sanity + valeurs par défaut, lib/content.ts)
const { journal } = Astro.props;

// Les articles arrivent déjà triés du plus récent au plus ancien
const posts: any[] = ((await getJournalPosts()) || []).slice(0, 5);
const entries = posts.map((p) => {
  const podcast = clean(p.category) === 'podcast';
  return {
    type: podcast ? 'podcast' : 'article',
    label: podcast ? 'Podcast' : 'Article',
    title: p.title,
    meta: podcast ? (p.episode ? `ÉPISODE ${p.episode}` : 'ÉCOUTER') : `${journalReadingTime(p.chars)} MIN DE LECTURE`,
    url: `/journal/${clean(p.slug)}`,
    img: journalCover(p, 800).src,
  };
});
// Les filtres n'ont de sens que si les deux types sont présents
const showFilters = entries.some((e) => e.type === 'podcast') && entries.some((e) => e.type === 'article');
---

<section class="journal" id="journal" data-anim="journal-section">
  <div class="journal-head">
    <h2 class="journal-title" data-anim="journal-title">
      {rich(journal.title).map((p) => (p.br ? <br /> : p.bold ? p.text : <span class="journal-thin">{p.text}</span>))}
    </h2>
    {showFilters && (
      <div class="journal-filters" role="group" aria-label="Filtrer le journal">
        <button class="journal-filter" type="button" data-filter="all" aria-pressed="true">{journal.filterAll}</button>
        <button class="journal-filter" type="button" data-filter="article" aria-pressed="false">{journal.filterArticles}</button>
        <button class="journal-filter" type="button" data-filter="podcast" aria-pressed="false">{journal.filterPodcast}</button>
      </div>
    )}
  </div>

  <ul class="journal-list" data-anim="journal-list">
    {entries.map((e, i) => (
      <li class="journal-item" data-type={e.type} data-index={i}>
        <a class="journal-item-link" href={e.url}>
          <span class="journal-item-type">{e.label}</span>
          <span class="journal-item-title">{e.title}</span>
          <span class="journal-item-meta">{e.meta}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="journal-more">
    <a class="journal-btn" href={href(journal.cta.url)}>{journal.cta.label}</a>
  </div>

  <div class="journal-preview" data-anim="journal-preview" aria-hidden="true">
    {entries.map((e, i) => (
      <img class="journal-preview-img" src={e.img} alt="" data-index={i} loading="lazy" decoding="async" />
    ))}
  </div>
</section>

<style>
  :root {
    --journal-pad-x: calc(40 * var(--fpx));
  }

  .journal {
    position: relative;
    width: 100%;
    padding: calc(140 * var(--fpx)) var(--journal-pad-x);
    background: var(--bg);
    color: var(--orange, #e57851);
    box-sizing: border-box;
  }

  .journal-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: calc(40 * var(--fpx));
    margin-bottom: calc(70 * var(--fpx));
  }

  .journal-title {
    margin: 0;
    font-family: 'Thunder', sans-serif;
    font-weight: 700;
    font-size: calc(120 * var(--fpx));
    line-height: 0.85;
    text-transform: uppercase;
  }

  .journal-thin { font-weight: 200; }

  .journal-filters { display: flex; gap: calc(8 * var(--fpx)); }

  .journal-filter {
    font-family: 'Thunder', sans-serif;
    font-weight: 400;
    font-size: calc(24 * var(--fpx));
    line-height: 1;
    color: var(--orange, #e57851);
    background: none;
    border: 1px solid var(--orange, #e57851);
    border-radius: 999px;
    padding: calc(10 * var(--fpx)) calc(20 * var(--fpx)) calc(8 * var(--fpx));
    cursor: pointer;
  }

  .journal-filter[aria-pressed='true'] {
    background: var(--orange, #e57851);
    color: var(--bg);
    font-weight: 800;
  }

  .journal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(229, 120, 81, 0.3);
  }

  .journal-item { border-bottom: 1px solid rgba(229, 120, 81, 0.3); }

  .journal-item-link {
    display: grid;
    grid-template-columns: calc(160 * var(--fpx)) 1fr auto;
    align-items: baseline;
    gap: calc(24 * var(--fpx));
    padding: calc(28 * var(--fpx)) 0;
  }

  .journal-item-type {
    font-family: 'Cormorant Infant', 'Times New Roman', serif;
    font-style: italic;
    font-size: calc(26 * var(--fpx));
  }

  .journal-item-title {
    font-family: 'Thunder', sans-serif;
    font-weight: 200;
    font-size: calc(56 * var(--fpx));
    line-height: 0.95;
    text-transform: uppercase;          /* titres saisis en casse normale dans Sanity */
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .journal-item-link:hover .journal-item-title,
  .journal-item-link:focus-visible .journal-item-title { transform: translateX(calc(24 * var(--fpx))); }

  .journal-item-meta {
    font-family: 'Thunder', sans-serif;
    font-weight: 400;
    font-size: calc(22 * var(--fpx));
    white-space: nowrap;
  }

  .journal-more { margin-top: calc(48 * var(--fpx)); }

  .journal-btn {
    font-family: 'Thunder', sans-serif;
    font-weight: 600;
    font-size: calc(32 * var(--fpx));
    line-height: 1;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    transition: opacity 0.2s ease;
  }

  .journal-btn:hover { opacity: 0.8; }

  /* Aperçu qui suit le curseur (desktop uniquement) */
  .journal-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: calc(260 * var(--fpx));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    pointer-events: none;
    z-index: 20;
    visibility: hidden;
  }

  .journal-preview-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .journal-title { visibility: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-item-title { transition: none; }
  }

  @media (max-width: 1023px) {
    .journal { padding: 5rem 1.5rem; }
    .journal-head { flex-direction: column; align-items: flex-start; gap: 1.5rem; margin-bottom: 2.5rem; }
    .journal-title { font-size: 3.5rem; }
    .journal-filter { font-size: 1.1rem; padding: 0.5rem 1rem 0.4rem; }
    .journal-item-link { grid-template-columns: 1fr; gap: 0.4rem; padding: 1.25rem 0; }
    .journal-item-type { font-size: 1.15rem; }
    .journal-item-title { font-size: 2rem; }
    .journal-item-meta { font-size: 1.05rem; }
    .journal-btn { font-size: 1.5rem; }
    .journal-preview { display: none; }
  }
</style>
