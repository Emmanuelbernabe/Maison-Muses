---
import { SIZES } from '../../lib/siteImage';
import { picture, href } from '../../lib/content';
import { rich, lines } from '../../lib/rich';
// Section équipe de la page d'accueil (Sanity + valeurs par défaut, lib/content.ts)
const { team } = Astro.props;
// Titre : une ligne par ligne du champ, un mot par <span> (animés un par un) ; hors **gras** → mot fin
const titleLines = lines(team.title).map((line) =>
  rich(line).flatMap((p) => p.text.split(/\s+/).filter(Boolean).map((w) => ({ w, thin: !p.bold }))),
);
const thumbImg = picture(team.thumb, SIZES.thumb, [160, 320, 480]);
const teamLeftImg = picture(team.left, SIZES.team);
const teamMidImg = picture(team.mid, SIZES.team);
const teamRightImg = picture(team.right, SIZES.team);
---

<section class="team" id="team" data-anim="team-section">
  <!-- ── 1. Header plein format en haut ── -->
  <h2 class="team-header" data-anim="team-header">
    {titleLines.map((words, i) => (
      <div class="team-header-line">
        {i === 0 && (
          <span class="team-thumb" data-anim="team-thumb">
            <img src={thumbImg.src} srcset={thumbImg.srcset} sizes={thumbImg.sizes} alt={thumbImg.alt} width="180" height="85" loading="lazy" decoding="async" />
          </span>
        )}
        {words.map(({ w, thin }) => <span class:list={['team-word', { 'team-word--thin': thin }]}>{w}</span>)}
      </div>
    ))}
  </h2>

  <!-- ── 2. Paragraphe en dessous du header, aligné à droite ── -->
  <div class="team-mid">
    <p class="team-para">
      {team.text}
    </p>
  </div>

  <!-- ── 3. Bloc bas : 3 colonnes photos avec parallax 110% ── -->
  <div class="team-bottom">
    <!-- Colonne 1 : photo gauche + bouton aligné au bas de l'image du milieu -->
    <div class="team-col team-col-left">
      <div class="team-img-frame team-frame-left">
        <img class="team-parallax-img" src={teamLeftImg.src} srcset={teamLeftImg.srcset} sizes={teamLeftImg.sizes} alt={teamLeftImg.alt} loading="lazy" decoding="async" />
      </div>
      <div class="team-action-wrap">
        <a class="team-btn" href={href(team.cta.url)}>{team.cta.label}</a>
      </div>
    </div>

    <!-- Colonne 2 : image du milieu, plus haute, descend jusqu'en bas -->
    <div class="team-col team-col-mid">
      <div class="team-img-frame team-frame-mid">
        <img class="team-parallax-img" src={teamMidImg.src} srcset={teamMidImg.srcset} sizes={teamMidImg.sizes} alt={teamMidImg.alt} loading="lazy" decoding="async" />
      </div>
    </div>

    <!-- Colonne 3 : photo droite + MUSES en bas aligné à l'image du milieu -->
    <div class="team-col team-col-right">
      <div class="team-img-frame team-frame-right">
        <img class="team-parallax-img" src={teamRightImg.src} srcset={teamRightImg.srcset} sizes={teamRightImg.sizes} alt={teamRightImg.alt} loading="lazy" decoding="async" />
      </div>
      <div class="team-muses-wrap">
        <span class="team-muses" data-anim="team-muses">MUSES</span>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    /* Section équipe */
    --team-pad-x: calc(40 * var(--fpx));
    --team-pad-y: calc(90 * var(--fpx));

    /* Header : 120px à 1440 */
    --team-header-fs: calc(120 * var(--fpx));
    --team-thumb-w: calc(175 * var(--fpx));
    --team-thumb-h: calc(85 * var(--fpx));

    /* Paragraphe : 40px à 1440 */
    --team-para-fs: calc(24 * var(--fpx));
    --team-para-w: calc(700 * var(--fpx));

    /* Colonnes photos */
    --team-gap: calc(16 * var(--fpx));

    --team-img-h-short: calc(440 * var(--fpx));
    --team-img-h-tall: calc(560 * var(--fpx));

    /* MUSES et Bouton */
    --team-muses-fs: calc(115 * var(--fpx));
    --team-btn-fs: calc(20 * var(--fpx));
  }

  .team {
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding: var(--team-pad-y) var(--team-pad-x);
    box-sizing: border-box;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: calc(40 * var(--fpx));
  }

  /* ── 1. Header plein format en haut ── */
  .team-header {
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: 'Thunder', sans-serif;
    font-size: var(--team-header-fs);
    font-weight: 700;
    line-height: 0.88;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .team-header-line {
    display: flex;
    align-items: top;
    flex-wrap: nowrap;
    gap: calc(14 * var(--fpx));
  }

  .team-thumb {
    width: var(--team-thumb-w);
    height: var(--team-thumb-h);
    overflow: hidden;
    flex-shrink: 0;
    display: inline-block;
  }

  .team-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mots du header : colorés au scroll */
  /* Couleur pleine : c'est l'opacité qui est animée au scroll (team.ts) */
  .team-word {
    display: inline-block;
    color: var(--orange, #e57851);
  }

  .team-word--thin {
  font-weight: 200;
}

  /* ── 2. Paragraphe en dessous du header, aligné à droite ── */
  .team-mid {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    margin-top: calc(10 * var(--fpx));
    margin-bottom: calc(20 * var(--fpx));
  }

  .team-para {
    margin: 0;
    padding: 0;
    width: var(--team-para-w);
    max-width: 100%;
    font-family: 'Thunder', sans-serif;
    font-size: var(--team-para-fs);
    font-weight: 400;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--orange, #e57851);
    letter-spacing: -0.01em;
    text-align: right;
  }

  /* ── 3. Bloc bas : 3 colonnes photos ── */
  .team-bottom {
    display: flex;
    gap: var(--team-gap);
    align-items: stretch;
    width: 100%;
    min-height: var(--team-img-h-tall);
  }

  .team-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .team-col-left {
    flex: 1.72 1 0;
  }

  .team-col-mid {
    flex: 1 1 0;
  }

  .team-col-right {
    flex: 1.05 1 0;
  }

  /* Cadre photo avec parallax (overflow hidden) */
  .team-img-frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    background: #e0ded8;
  }

  .team-frame-left {
    height: var(--team-img-h-short);
  }

  .team-frame-mid {
    height: var(--team-img-h-tall);
  }

  .team-frame-right {
    height: var(--team-img-h-short);
  }

  /* Images avec height 110% pour parallax sans zoom excessif */
  .team-parallax-img {
    position: absolute;
    top: -5%;
    left: 0;
    width: 100%;
    height: 110%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }

  /* Zone d'action sous photo gauche : alignée en bas comme l'image du milieu */
  .team-action-wrap {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    flex: 1 1 auto;
    padding-bottom: calc(4 * var(--fpx));
  }

  .team-btn {
    font-family: 'Thunder', sans-serif;
    font-size: var(--team-btn-fs);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--orange, #e57851);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    letter-spacing: 0.03em;
    cursor: pointer;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .team-btn:hover {
    opacity: 0.75;
  }

  /* MUSES en bas à droite : aligné avec le bas de l'image du milieu */
  .team-muses-wrap {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    flex: 1 1 auto;
    line-height: 0.8;
  }

  .team-muses {
    font-family: 'Cormorant Infant', 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    font-size: var(--team-muses-fs);
    line-height: 0.82;
    letter-spacing: -0.02em;
    color: var(--orange, #e57851);
    display: inline-block;
    will-change: transform;
  }

  /* Responsive Mobile / Tablette */
  @media (max-width: 1023px) {
    .team {
      padding: 3rem 1.5rem;
      gap: 2.5rem;
      height: auto;
      min-height: auto;
    }

    /* Header : un seul bloc de texte qui revient à la ligne naturellement (plus de lignes forcées) */
    .team-header {
      display: block;
      font-size: clamp(2.8rem, 9vw, 5.5rem);
    }
    .team-header-line {
      display: contents;
    }
    .team-word {
      margin-right: 0.2em;
    }
    .team-thumb {
      width: clamp(80px, 20vw, 120px);
      height: clamp(40px, 10vw, 60px);
      margin-right: 0.2em;
      vertical-align: top;
    }

    .team-mid {
      margin: 1rem 0;
      justify-content: flex-start;
    }
    .team-para {
      width: 100%;
      text-align: left;
      font-size: clamp(1.4rem, 4vw, 2rem);
    }

    /* Photos empilées, MUSES qui chevauche la dernière, puis le bouton */
    .team-bottom {
      flex-direction: column;
      gap: 2rem;
      min-height: auto;
    }
    .team-col {
      display: contents;
    }
    .team-frame-left { order: 1; }
    .team-frame-mid { order: 2; }
    .team-frame-right { order: 3; }
    .team-frame-left, .team-frame-mid, .team-frame-right {
      height: 60vw;
    }
    .team-muses-wrap {
      order: 4;
      position: relative;
      z-index: 2;
      justify-content: flex-end;
      margin-top: -4.6rem;
    }
    .team-muses {
      font-size: 4rem;
    }
    .team-action-wrap {
      order: 5;
      justify-content: flex-start;
      margin-top: -0.5rem;
      padding-bottom: 0;
    }
  }
</style>
