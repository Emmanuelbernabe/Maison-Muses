---
import { SIZES } from '../../lib/siteImage';
import { HOME, merge, picture } from '../../lib/content';
// gallery : 5 photos du marquee ; center : portrait central (relais avec l'intro), mêmes réglages que dans le hero
const { gallery, center } = Astro.props;
// La mise en page attend 5 photos : celles qui manquent dans Sanity reprennent la photo par défaut du même rang
const at = (i: number) => gallery.images[i] ?? merge(HOME.gallery.images[i], undefined);
const slides = [at(0), center, at(1), at(2), at(3), at(4)].map((m) => picture(m, SIZES.portrait));
---
<section class="gallery" id="gallery" data-anim="gallery-section">
  <div class="gallery-row">
    <div class="gallery-track" data-anim="gallery-track">
      {[0, 1].map((g) => slides.map((img, i) => (
        <div class="gallery-item" data-center={g === 0 && i === 1 ? '' : undefined} aria-hidden={g === 1 ? 'true' : undefined}>
          <img src={img.src} srcset={img.srcset} sizes={img.sizes} alt="" loading="eager" decoding="async" draggable="false" />
        </div>
      )))}
    </div>
  </div>
</section>

<style>
  .gallery {
    --gallery-w: var(--hero-portrait-w);
    --gallery-gap: calc(45 * var(--fpx));
    position: relative; z-index: 1;
    height: 100vh; overflow: hidden;
  }
  .gallery-row { position: absolute; inset: 0; }
  .gallery-track {
    position: absolute;
    top: 50%;
    height: var(--hero-portrait-h);
    margin-top: calc(var(--hero-portrait-h) / -2);
    /* l'image d'index 1 (ciseaux) est centrée, celle d'index 0 commence à x=0 à 1440 */
    left: calc(50% - var(--gallery-w) / 2 - (var(--gallery-w) + var(--gallery-gap)));
    display: flex; gap: var(--gallery-gap);
    will-change: transform;
  }
  .gallery-item { flex: none; width: var(--gallery-w); height: 100%; overflow: hidden; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gallery-item[data-center] { visibility: hidden; }  /* révélée au passage de relais */

  /* Mobile / tablette : pas de pin, la section prend la hauteur du marquee + le padding commun (5rem) */
  @media (max-width: 1023px) {
    .gallery { height: auto; padding: 5rem 0; }
    .gallery-row { position: relative; inset: auto; height: var(--hero-portrait-h); }
    .gallery-track { top: 0; margin-top: 0; }
  }
</style>
