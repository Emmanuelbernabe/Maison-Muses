---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import VisualEditing from '../components/layout/VisualEditing.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';

import { clean, urlFor } from '../lib/sanity';
import { loadHome, loadSettings } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /* Image de partage (URL absolue) : par défaut le portrait de l'accueil */
  image?: string;
  type?: 'website' | 'article';
  /* Données structurées de la page (lib/seo.ts) */
  jsonLd?: object;
  noindex?: boolean;
}
const { title, description, image, type = 'website', jsonLd, noindex = false } = Astro.props;

// Adresse de référence de chaque page : toujours le domaine définitif (astro.config → site),
// y compris sur la démo workers.dev, pour que Google ne voie qu'un seul site
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = await loadHome();
// Google Tag Manager (Réglages du site → Cookies) : chargé seulement après accord (scripts/layout/consent.ts)
const gtmId = clean((await loadSettings()).cookies.gtmId);
const shareImage = image
  ?? (home.hero.portrait.image ? urlFor(home.hero.portrait.image).width(1200).height(630).fit('crop').auto('format').url() : new URL('/favicon.png', Astro.site).href);
const pageTitle = clean(title);
const pageDescription = clean(description);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F7F2EC" />
    <!-- Aperçu des liens partagés (WhatsApp, Instagram, Facebook, LinkedIn…) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Maison Muses" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {pageDescription && <meta name="twitter:description" content={pageDescription} />}
    <meta name="twitter:image" content={shareImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" href="/fonts/Thunder-VF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Infant:ital,wght@0,400;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500&display=swap" rel="stylesheet" />
    <!-- Les états « avant animation » du CSS ne s'appliquent que si le JS tourne -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <!-- Consentement : tout est refusé par défaut (Google Consent Mode v2) ; le choix enregistré est appliqué
         par scripts/layout/consent.ts. Une seule fois, même si la tête de page est rejouée à la navigation -->
    <script is:inline define:vars={{ gtmId }}>
      if (!window.__mmConsentInit) {
        window.__mmConsentInit = true;
        window.__mmGtmId = gtmId || '';
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
      }
    </script>
    <!-- Rechargement de la page : la page reste masquée, puis apparaît avec la même transition
         qu'entre deux pages (voir startPage dans scripts/main.ts) -->
    <script is:inline>
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'reload' && document.startViewTransition
            && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('mm-reload');
          // Filet de sécurité : la page s'affiche quoi qu'il arrive
          setTimeout(function () { document.documentElement.classList.add('mm-ready'); }, 4000);
        }
      } catch (e) {}
    </script>
    <!-- Navigation sans rechargement, avec les View Transitions (animations dans global.css) -->
    <ClientRouter />
  </head>

  <VisualEditing />
  
  <body>
    <!-- Clavier : premier élément de la page, visible seulement au focus, pour sauter le menu -->
    <a class="skip-link" href="#top">Aller au contenu</a>
    <slot />
    <CookieBanner />
  </body>
</html>