---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ServiceHero from '../components/ServiceHero.astro';
import ServiceApproach from '../components/ServiceApproach.astro';
import ServiceSlider from '../components/ServiceSlider.astro';
import ServiceAccordion from '../components/ServiceAccordion.astro';
import Section9 from '../components/Section9.astro';
import { getSettings, getServicePage } from '../lib/sanity';
import { buildServicePage } from '../lib/servicePage';

const [settings, doc] = await Promise.all([getSettings(), getServicePage('page-coiffure')]);
if (!settings) {
  throw new Error("Contenu introuvable : publiez « Réglages du site » dans Sanity (voir README).");
}
// Contenu modifiable dans le Studio : Pages du site → Espace coiffure
const page = buildServicePage('coiffure', doc);
---
<Layout
  title={page.seoTitle || "L’espace coiffure – Maison Muses, Toulouse"}
  description={page.seoDescription || "L’espace coiffure de Maison Muses par Moussine : consultation, diagnostic et soins haut de gamme, au centre de Toulouse."}
>
  <Header logo={settings.logo} cta={settings.headerCta} />
  <main id="top" style="--sp-c: var(--orange, #e57851);">
    <ServiceHero hero={page.hero} label="Espace coiffure" />
    <ServiceApproach approach={page.approach} />
    <ServiceSlider slides={page.gallery} label="Réalisations du salon" />
    <ServiceAccordion steps={page.steps} brands={page.brands} social={page.social} />
  </main>
  <!-- CTA « Prenez le temps » + footer -->
  <Section9 />
  <script>
    import '../scripts/main';
  </script>
</Layout>
