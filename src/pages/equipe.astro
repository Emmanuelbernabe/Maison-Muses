---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import EquipeHero from '../components/equipe/EquipeHero.astro';
import EquipeMembers from '../components/equipe/EquipeMembers.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { getSettings } from '../lib/sanity';

const settings = await getSettings();
if (!settings) {
  throw new Error("Contenu introuvable : publiez « Réglages du site » dans Sanity (voir README).");
}
---
<Layout
  title="L’équipe – Maison Muses, coiffure et bien-être à Toulouse"
  description="Moussine, coiffeur, et Violaine, praticienne bien-être : l’équipe de Maison Muses au centre de Toulouse."
>
  <Header logo={settings.logo} cta={settings.headerCta} />
  <main id="top">
    <EquipeHero />
    <EquipeMembers />
  </main>
  <!-- CTA « Prenez le temps » + footer -->
  <SiteFooter />
  <script>
    import '../scripts/main';
  </script>
</Layout>
