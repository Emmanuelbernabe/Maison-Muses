---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import EquipeHero from '../components/equipe/EquipeHero.astro';
import EquipeMembers from '../components/equipe/EquipeMembers.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { getSettings } from '../lib/sanity';
import { loadEquipe } from '../lib/content';

const [settings, equipe] = await Promise.all([getSettings(), loadEquipe()]);
if (!settings) {
  throw new Error("Contenu introuvable : publiez « Réglages du site » dans Sanity (voir README).");
}
---
<Layout
  title={equipe.seoTitle}
  description={equipe.seoDescription}
>
  <Header />
  <main id="top">
    <EquipeHero equipe={equipe} />
    <EquipeMembers equipe={equipe} />
  </main>
  <!-- CTA « Prenez le temps » + footer -->
  <SiteFooter />
  <script>
    import '../scripts/main';
  </script>
</Layout>
