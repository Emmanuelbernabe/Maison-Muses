---
// Page marque (modèle) : une page par marque, créée depuis Sanity (Pages du site → Marques)
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import BrandHero from '../../components/brand/BrandHero.astro';
import BrandOverview from '../../components/brand/BrandOverview.astro';
import BrandProducts from '../../components/brand/BrandProducts.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { getSettings, getBrands, getBrand, clean } from '../../lib/sanity';
import { buildBrandPage } from '../../lib/brand';

export async function getStaticPaths() {
  const brands: any[] = (await getBrands()) || [];
  return brands.map((doc) => ({ params: { slug: clean(doc.slug) }, props: { doc } }));
}

const { slug } = Astro.params;
// En mode aperçu (rendu serveur), getStaticPaths n'est pas appelé : on charge la marque ici
const doc = (Astro.props as any).doc ?? (await getBrand(slug!));
const settings = await getSettings();
if (!settings) {
  throw new Error("Contenu introuvable : publiez « Réglages du site » dans Sanity (voir README).");
}
if (!doc) return Astro.redirect('/404');
const brand = buildBrandPage(doc);
---
<Layout
  title={brand.seoTitle || `${clean(brand.name)} – Nos marques – Maison Muses, Toulouse`}
  description={brand.seoDescription || clean(brand.intro) || `${clean(brand.name)}, une marque choisie par Maison Muses.`}
>
  <Header />
  <main id="top" style="--br-ink: #7d4330; --br-mut: rgba(125, 67, 48, 0.55);">
    <BrandHero brand={brand} />
    <BrandOverview brand={brand} />
    <BrandProducts brand={brand} />
  </main>
  <SiteFooter />
  <script>
    import '../../scripts/main';
  </script>
</Layout>
