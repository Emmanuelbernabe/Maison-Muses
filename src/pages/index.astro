---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeIntro from '../components/home/HomeIntro.astro';
import HomeGallery from '../components/home/HomeGallery.astro';
import HomeTeam from '../components/home/HomeTeam.astro';
import HomeCoffrets from '../components/home/HomeCoffrets.astro';
import HomeReviews from '../components/home/HomeReviews.astro';
import HomeRoutines from '../components/home/HomeRoutines.astro';
import HomeJournal from '../components/home/HomeJournal.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import LoadingScreen from '../components/home/LoadingScreen.astro';
import { loadHome } from '../lib/content';

// Contenu de la page d'accueil (Sanity, complété par les valeurs par défaut de lib/content.ts)
const home = await loadHome();
---
<Layout title={home.seoTitle} description={home.seoDescription}>
  <LoadingScreen loader={home.loader} hero={home.hero} />
  <Header />
  <main id="top">
    <!-- Hero et intro dans le flux normal sans pin superposé -->
    <HomeHero hero={home.hero} />
    <HomeIntro intro={home.intro} />
    <HomeGallery gallery={home.gallery} center={home.hero.center} />
    <HomeTeam team={home.team} />
    <HomeCoffrets coffrets={home.coffrets} />
    <HomeReviews reviews={home.reviews} />
    <HomeRoutines routines={home.routines} />
    <HomeJournal journal={home.journal} />
  </main>
  <SiteFooter />
  <script>
    import '../scripts/main';
  </script>
</Layout>
