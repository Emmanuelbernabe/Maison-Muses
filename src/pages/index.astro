---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeIntro from '../components/home/HomeIntro.astro';
import HomeGallery from '../components/home/HomeGallery.astro';
import HomeTeam from '../components/home/HomeTeam.astro';
import HomeCoffrets from '../components/home/HomeCoffrets.astro';
import HomeReviews from '../components/home/HomeReviews.astro';
import HomeRoutines from '../components/home/HomeRoutines.astro';
import HomeJournal from '../components/home/HomeJournal.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import LoadingScreen from '../components/home/LoadingScreen.astro';
import { getHome, getSettings } from '../lib/sanity';

const [home, settings] = await Promise.all([getHome(), getSettings()]);
if (!home || !settings) {
  throw new Error("Contenu introuvable : publiez « Page d'accueil » et « Réglages du site » dans Sanity (voir README).");
}
---
<Layout
  title={home.seoTitle ?? 'Maison Muses – Coiffure et bien-être à Toulouse'}
  description={home.seoDescription}
>
  <LoadingScreen photos={home.photos} />
  <Header logo={settings.logo} cta={settings.headerCta} />
  <main id="top">
    <!-- Hero et intro dans le flux normal sans pin superposé -->
    <HomeHero data={home.hero} photos={home.photos} />
    <HomeIntro data={home.intro} photos={home.photos} />
    <HomeGallery photos={home.photos} />
    <HomeTeam photos={home.photos} />
    <HomeCoffrets photos={home.photos} />
    <HomeReviews />
    <HomeRoutines photos={home.photos} />
    <HomeJournal />
  </main>
  <SiteFooter />
  <script>
    import '../scripts/main';
  </script>
</Layout>
