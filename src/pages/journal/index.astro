---
// Journal — hub : article à la une, filtres par catégorie, grille
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import JournalCard from '../../components/journal/JournalCard.astro';
import { getSettings, getJournalPosts } from '../../lib/sanity';
import { JOURNAL_CATEGORIES, journalCover, journalCategoryLabel, journalDate, journalReadingTime } from '../../lib/journal';

const [settings, posts] = await Promise.all([getSettings(), getJournalPosts()]);
if (!settings) {
  throw new Error("Contenu introuvable : publiez « Réglages du site » dans Sanity (voir README).");
}

const list: any[] = posts || [];
// À la une : le plus récent coché « À la une », sinon le plus récent
const featured = list.find((p) => p.featured) || list[0];
const others = list.filter((p) => p !== featured);
const featuredCover = featured ? journalCover(featured, 1600) : null;
// Filtres : seulement les catégories qui ont des articles
const categories = JOURNAL_CATEGORIES.filter((c) => others.some((p) => p.category === c.value));
---
<Layout
  title="Le journal – Maison Muses, coiffure et bien-être à Toulouse"
  description="Conseils coiffure, rituels bien-être et épisodes du podcast : le journal de Maison Muses."
>
  <Header logo={settings.logo} cta={settings.headerCta} />
  <main id="top">
    <section class="jr-hub" data-anim="jr-hub" aria-label="Le journal">
      <div class="jr-head">
        <h1 class="jr-title"><span class="jr-title-it">Le journal des</span>Muses</h1>
        {categories.length > 1 && (
          <div class="jr-filters" role="group" aria-label="Filtrer par catégorie" data-jr-filters>
            <button type="button" aria-pressed="true" data-filter="all">Tous</button>
            {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c.value}>{c.label}</button>)}
          </div>
        )}
      </div>

      {featured ? (
        <a class="jr-feat" href={`/journal/${featured.slug}`}>
          <figure class="jr-feat-photo" data-jr-parallax>
            <img src={featuredCover!.src} srcset={featuredCover!.srcset} sizes="(max-width: 899px) 100vw, 55vw" alt={featuredCover!.alt} decoding="async" />
          </figure>
          <div class="jr-feat-text">
            <p class="jr-cat">À la une · <b>{journalCategoryLabel(featured.category)}</b></p>
            <h2 class="jr-feat-title">{featured.title}</h2>
            {featured.excerpt && <p class="jr-feat-excerpt">{featured.excerpt}</p>}
            <span class="jr-date">{journalDate(featured.publishedAt)} · {journalReadingTime(featured.chars)} min de lecture</span>
          </div>
        </a>
      ) : (
        <p class="jr-empty">Les premiers articles arrivent bientôt.</p>
      )}

      {others.length > 0 && (
        <div class="jr-grid" data-jr-grid>
          {others.map((post) => <JournalCard post={post} />)}
        </div>
      )}
    </section>
  </main>
  <SiteFooter />
  <script>
    import '../../scripts/main';
  </script>
</Layout>

<style>
  .jr-hub {
    padding: calc(150 * var(--fpx)) calc(40 * var(--fpx)) calc(120 * var(--fpx));
    color: var(--orange, #e57851);
  }

  .jr-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-bottom: calc(50 * var(--fpx)); }

  .jr-title {
    margin: 0;
    font-family: 'Cormorant Infant', serif;
    font-weight: 400;
    font-size: calc(200 * var(--fpx));
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .jr-title-it { display: block; font-style: italic; font-size: 0.32em; letter-spacing: 0; text-transform: none; }

  .jr-filters { display: flex; flex-wrap: wrap; gap: calc(10 * var(--fpx)); }

  .jr-filters button {
    padding: calc(10 * var(--fpx)) calc(18 * var(--fpx)) calc(8 * var(--fpx));
    border: 1px solid currentColor;
    border-radius: 999px;
    background: none;
    color: inherit;
    cursor: pointer;
    font-family: 'Thunder', sans-serif;
    font-size: calc(20 * var(--fpx));
    line-height: 1;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s;
  }

  .jr-filters button[aria-pressed='true'] { background: var(--orange, #e57851); color: var(--bg, #F7F2EC); }
  .jr-filters button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .jr-feat {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: calc(50 * var(--fpx));
    align-items: end;
    padding: calc(40 * var(--fpx)) 0;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
  }

  .jr-feat-photo { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
  /* Parallaxe (journal.ts) : image 12 % plus haute que son cadre, décalée de 6 % vers le haut */
  .jr-feat-photo img { position: relative; top: -6%; width: 100%; height: 112%; object-fit: cover; display: block; transition: scale 1s cubic-bezier(0.22, 1, 0.36, 1); }
  .jr-feat:hover .jr-feat-photo img { scale: 1.04; }

  .jr-feat-text { display: flex; flex-direction: column; gap: calc(22 * var(--fpx)); }

  .jr-cat {
    margin: 0;
    font-family: 'Thunder', sans-serif;
    font-weight: 200;
    font-size: calc(20 * var(--fpx));
    line-height: 1;
    text-transform: uppercase;
  }

  .jr-cat b { font-weight: 700; }

  .jr-feat-title {
    margin: 0;
    font-family: 'Thunder', sans-serif;
    font-weight: 700;
    font-size: calc(76 * var(--fpx));
    line-height: 0.9;
    text-transform: uppercase;
  }

  .jr-feat-excerpt { margin: 0; font-size: calc(17 * var(--fpx)); line-height: 1.5; }
  .jr-date { font-family: 'Cormorant Infant', serif; font-style: italic; font-size: calc(20 * var(--fpx)); }

  .jr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(50 * var(--fpx)) calc(30 * var(--fpx));
    margin-top: calc(60 * var(--fpx));
  }

  .jr-empty { margin: 0; padding: calc(60 * var(--fpx)) 0; border-top: 1px solid currentColor; font-family: 'Cormorant Infant', serif; font-style: italic; font-size: calc(30 * var(--fpx)); }

  @media (max-width: 899px) {
    .jr-hub { padding: 6rem 1.25rem 4rem; }
    .jr-head { flex-direction: column; align-items: flex-start; }
    .jr-title { font-size: 5rem; }
    .jr-filters button { font-size: 1rem; }
    .jr-feat { grid-template-columns: 1fr; gap: 1.5rem; }
    .jr-feat-title { font-size: 2.4rem; }
    .jr-feat-excerpt { font-size: 0.95rem; }
    .jr-cat { font-size: 0.95rem; }
    .jr-date { font-size: 1rem; }
    .jr-grid { grid-template-columns: 1fr 1fr; gap: 2rem 0.8rem; }
  }
</style>
